# Copia este archivo a .env y ajusta valores para tu entorno local.
# docker-compose.yml ya trae defaults de desarrollo si no defines .env.

POSTGRES_USER=obrix
POSTGRES_PASSWORD=obrix_dev_password
POSTGRES_DB=obrix_licensing

# Secreto para firmar JWT de GoTrue — cambia esto en cualquier entorno real.
GOTRUE_JWT_SECRET=dev_jwt_secret_change_me_min_32_chars
GOTRUE_SITE_URL=http://localhost:9999

# OAuth Google — vacío por default (login social deshabilitado hasta
# configurar credenciales en Google Cloud Console).
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:9999/callback

# admin-server (panel interno de suscripciones/usuarios, http://localhost:8090)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_dev_password
ADMIN_SESSION_SECRET=dev_admin_session_secret_change_me
